rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidGunType(gunType) {
      return gunType in ['PULSE_PISTOL', 'HEAVY_DEAGLE', 'SCATTER_SHOTGUN', 'VECTOR_SMG', 'RAIL_CANNON'];
    }

    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 32 &&
             data.avatarIndex is int && data.avatarIndex >= 0 && data.avatarIndex <= 10 &&
             data.onlineWins is int && data.onlineWins >= 0 && data.onlineWins <= 1000000 &&
             data.onlineMatches is int && data.onlineMatches >= 0 && data.onlineMatches <= 1000000 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidPvpRoom(data) {
      return data.roomCode is string && data.roomCode.size() >= 4 && data.roomCode.size() <= 12 &&
             data.roomCode.matches('^[A-Z0-9_\\-]+$') &&
             data.hostUid is string && data.hostUid.size() >= 1 && data.hostUid.size() <= 128 &&
             data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 32 &&
             data.status in ['waiting', 'playing', 'finished'] &&
             data.isPublic is bool &&
             (!('guestUid' in data) || (data.guestUid is string && data.guestUid.size() >= 1 && data.guestUid.size() <= 128 && data.guestUid != data.hostUid)) &&
             (!('guestName' in data) || (data.guestName is string && data.guestName.size() >= 1 && data.guestName.size() <= 32)) &&
             (!('winnerUid' in data) || (data.winnerUid is string && data.winnerUid.size() >= 1 && data.winnerUid.size() <= 128 && (data.winnerUid == data.hostUid || ('guestUid' in data && data.winnerUid == data.guestUid)))) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidPvpPlayer(data) {
      return data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 32 &&
             isValidGunType(data.gunType) &&
             data.normX is number && data.normX >= -0.25 && data.normX <= 1.25 &&
             data.normY is number && data.normY >= -0.25 && data.normY <= 1.25 &&
             data.normVx is number && data.normVx >= -12.0 && data.normVx <= 12.0 &&
             data.normVy is number && data.normVy >= -12.0 && data.normVy <= 12.0 &&
             data.angle is number && data.angle >= -6.5 && data.angle <= 6.5 &&
             data.angularVelocity is number && data.angularVelocity >= -20.0 && data.angularVelocity <= 20.0 &&
             data.shotsFired is int && data.shotsFired >= 0 && data.shotsFired <= 100000 &&
             data.simultaneousHits is int && data.simultaneousHits >= 0 && data.simultaneousHits <= 3 &&
             data.isEliminated is bool &&
             (!data.isEliminated || data.simultaneousHits >= 3) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidPvpShot(data) {
      return data.shooterUid is string && data.shooterUid.size() >= 1 && data.shooterUid.size() <= 128 &&
             data.participantUids is list && data.participantUids.size() == 2 &&
             data.participantUids[0] is string && data.participantUids[1] is string &&
             data.participantUids[0] != data.participantUids[1] &&
             isValidGunType(data.gunType) &&
             data.normX is number && data.normX >= -0.25 && data.normX <= 1.25 &&
             data.normY is number && data.normY >= -0.25 && data.normY <= 1.25 &&
             data.dirAngle is number && data.dirAngle >= -6.5 && data.dirAngle <= 6.5 &&
             data.pellets is int && data.pellets >= 1 && data.pellets <= 5 &&
             data.spreadRadians is number && data.spreadRadians >= 0.0 && data.spreadRadians <= 1.0 &&
             data.seq is int && data.seq >= 1 && data.seq <= 1000000 &&
             data.createdAt is timestamp;
    }

    function isRoomParticipant(roomId) {
      let room = get(/databases/$(database)/documents/pvp_rooms/$(roomId)).data;
      return room != null && (
        room.hostUid == request.auth.uid ||
        ('guestUid' in room && room.guestUid == request.auth.uid)
      );
    }

    function isRoomParticipantAfter(roomId) {
      let room = getAfter(/databases/$(database)/documents/pvp_rooms/$(roomId)).data;
      return room != null && (
        room.hostUid == request.auth.uid ||
        ('guestUid' in room && room.guestUid == request.auth.uid)
      );
    }

    function isPlayingRoomWithParticipants(roomId, participantUids) {
      let room = get(/databases/$(database)/documents/pvp_rooms/$(roomId)).data;
      return room != null &&
             room.status == 'playing' &&
             ('guestUid' in room) &&
             (request.auth.uid == room.hostUid || request.auth.uid == room.guestUid) &&
             participantUids.hasAll([room.hostUid, room.guestUid]);
    }

    // Owner-isolated online user stats
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().uid == request.auth.uid &&
                       incoming().keys().hasAll(['uid', 'displayName', 'avatarIndex', 'onlineWins', 'onlineMatches', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['uid', 'displayName', 'avatarIndex', 'onlineWins', 'onlineMatches', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming()) &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt <= request.time;

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserProfile(incoming()) &&
                       incoming().uid == existing().uid &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatarIndex', 'onlineWins', 'onlineMatches', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // Internet PvP Match Rooms
    match /pvp_rooms/{roomId} {
      allow get: if isSignedIn() && isValidId(roomId) && (
        existing().status == 'waiting' ||
        existing().hostUid == request.auth.uid ||
        (('guestUid' in existing()) && existing().guestUid == request.auth.uid)
      );

      allow list: if isSignedIn() && (
        existing().status == 'waiting' ||
        existing().hostUid == request.auth.uid ||
        (('guestUid' in existing()) && existing().guestUid == request.auth.uid)
      );

      allow create: if isSignedIn() &&
                       isValidId(roomId) &&
                       incoming().roomCode == roomId &&
                       incoming().hostUid == request.auth.uid &&
                       incoming().status == 'waiting' &&
                       !('guestUid' in incoming()) &&
                       !('guestName' in incoming()) &&
                       !('winnerUid' in incoming()) &&
                       incoming().keys().hasAll(['roomCode', 'hostUid', 'hostName', 'status', 'isPublic', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['roomCode', 'hostUid', 'hostName', 'guestUid', 'guestName', 'status', 'isPublic', 'winnerUid', 'createdAt', 'updatedAt']) &&
                       isValidPvpRoom(incoming()) &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt <= request.time;

      allow update: if isSignedIn() &&
                       isValidId(roomId) &&
                       isValidPvpRoom(incoming()) &&
                       existing().status != 'finished' &&
                       incoming().hostUid == existing().hostUid &&
                       incoming().roomCode == existing().roomCode &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt <= request.time && (
                         // Action 1: Guest joins an open waiting room
                         (
                           existing().status == 'waiting' &&
                           request.auth.uid != existing().hostUid &&
                           incoming().guestUid == request.auth.uid &&
                           ('guestName' in incoming()) &&
                           incoming().status == 'playing' &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['guestUid', 'guestName', 'status', 'updatedAt'])
                         ) ||
                         // Action 2: Either participant records final winner once eliminated by 3 simultaneous hits
                         (
                           existing().status == 'playing' &&
                           (request.auth.uid == existing().hostUid || (('guestUid' in existing()) && request.auth.uid == existing().guestUid)) &&
                           incoming().status == 'finished' &&
                           ('winnerUid' in incoming()) &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'winnerUid', 'updatedAt'])
                         ) ||
                         // Action 3: Host updates waiting room visibility
                         (
                           existing().status == 'waiting' &&
                           request.auth.uid == existing().hostUid &&
                           incoming().status == 'waiting' &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['isPublic', 'updatedAt'])
                         )
                       );

      allow delete: if isSignedIn() && isValidId(roomId) && request.auth.uid == existing().hostUid && existing().status == 'waiting';

      // Per-player gun state (single-document listener only; list disabled)
      match /players/{playerUid} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(playerUid) && (
          request.auth.uid == playerUid || isRoomParticipant(roomId)
        );
        allow list: if false;

        allow create: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(playerUid) &&
                         request.auth.uid == playerUid &&
                         incoming().uid == request.auth.uid &&
                         incoming().keys().hasAll(['uid', 'displayName', 'gunType', 'normX', 'normY', 'normVx', 'normVy', 'angle', 'angularVelocity', 'shotsFired', 'simultaneousHits', 'isEliminated', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['uid', 'displayName', 'gunType', 'normX', 'normY', 'normVx', 'normVy', 'angle', 'angularVelocity', 'shotsFired', 'simultaneousHits', 'isEliminated', 'createdAt', 'updatedAt']) &&
                         isValidPvpPlayer(incoming()) &&
                         incoming().createdAt <= request.time &&
                         incoming().updatedAt <= request.time &&
                         isRoomParticipantAfter(roomId);

        allow update: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(playerUid) &&
                         request.auth.uid == playerUid &&
                         !existing().isEliminated &&
                         isValidPvpPlayer(incoming()) &&
                         incoming().uid == existing().uid &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt <= request.time &&
                         isRoomParticipant(roomId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'gunType', 'normX', 'normY', 'normVx', 'normVy', 'angle', 'angularVelocity', 'shotsFired', 'simultaneousHits', 'isEliminated', 'updatedAt']);

        allow delete: if false;
      }

      // Append-only shot events (participant-scoped queries)
      match /shots/{shotId} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(shotId) && (
          request.auth.uid in existing().participantUids
        );
        allow list: if isSignedIn() && (
          request.auth.uid in existing().participantUids
        );

        allow create: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(shotId) &&
                         incoming().shooterUid == request.auth.uid &&
                         (request.auth.uid in incoming().participantUids) &&
                         incoming().keys().hasAll(['shooterUid', 'participantUids', 'gunType', 'normX', 'normY', 'dirAngle', 'pellets', 'spreadRadians', 'seq', 'createdAt']) &&
                         incoming().keys().hasOnly(['shooterUid', 'participantUids', 'gunType', 'normX', 'normY', 'dirAngle', 'pellets', 'spreadRadians', 'seq', 'createdAt']) &&
                         isValidPvpShot(incoming()) &&
                         incoming().createdAt <= request.time &&
                         isPlayingRoomWithParticipants(roomId, incoming().participantUids);

        allow update, delete: if false;
      }
    }
  }
}
